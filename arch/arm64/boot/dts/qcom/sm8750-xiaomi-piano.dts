		vdd-l1-supply = <&vreg_s7i_1p2>;
		vdd-l2-supply = <&vreg_s7i_1p2>;
		vdd-l3-supply = <&vreg_s1d_0p97>;
		vdd-s7-supply = <&vph_pwr>;
		vdd-s8-supply = <&vph_pwr>;

		qcom,pmic-id = "i";

		vreg_s7i_1p2: smps7 {
			regulator-name = "vreg_s7i_1p2";
			regulator-min-microvolt = <1224000>;
			regulator-max-microvolt = <1340000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_s8i_0p9: smps8 {
			regulator-name = "vreg_s8i_0p9";
			regulator-min-microvolt = <900000>;
			regulator-max-microvolt = <972000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l1i_1p2: ldo1 {
			regulator-name = "vreg_l1i_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2i_1p2: ldo2 {
			regulator-name = "vreg_l2i_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l3i_0p88: ldo3 {
			regulator-name = "vreg_l3i_0p88";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <912000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-5 {
		compatible = "qcom,pm8550vs-rpmh-regulators";

		vdd-l1-supply = <&vreg_s1d_0p97>;
		vdd-l2-supply = <&vreg_s7i_1p2>;
		vdd-s2-supply = <&vph_pwr>;
		vdd-s3-supply = <&vph_pwr>;
		vdd-s4-supply = <&vph_pwr>;

		qcom,pmic-id = "j";

		vreg_s2j_1p1: smps2 {
			regulator-name = "vreg_s2j_1p1";
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <1100000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_s3j_1p1: smps3 {
			regulator-name = "vreg_s3j_1p1";
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <1100000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l1j_0p91: ldo1 {
			regulator-name = "vreg_l1j_0p91";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <920000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2j_1p2: ldo2 {
			regulator-name = "vreg_l2j_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-6 {
		compatible = "qcom,pm8010-rpmh-regulators";
		qcom,pmic-id = "m";

		vdd-l1-l2-supply = <&vreg_s7i_1p2>;
		vdd-l3-l4-supply = <&vreg_bob2>;
		vdd-l5-supply = <&vreg_s3g_1p8>;
		vdd-l6-supply = <&vreg_bob1>;
		vdd-l7-supply = <&vreg_bob1>;

		vreg_l1m_1p1: ldo1 {
			regulator-name = "vreg_l1m_1p1";
			regulator-min-microvolt = <1104000>;
			regulator-max-microvolt = <1104000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2m_1p056: ldo2 {
			regulator-name = "vreg_l2m_1p056";
			regulator-min-microvolt = <1056000>;
			regulator-max-microvolt = <1056000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l3m_2p8: ldo3 {
			regulator-name = "vreg_l3m_2p8";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l4m_2p8: ldo4 {
			regulator-name = "vreg_l4m_2p8";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l5m_1p8: ldo5 {
			regulator-name = "vreg_l5m_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l6m_2p8: ldo6 {
			regulator-name = "vreg_l6m_2p8";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l7m_2p96: ldo7 {
			regulator-name = "vreg_l7m_2p96";
			regulator-min-microvolt = <2960000>;
			regulator-max-microvolt = <2960000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	/* No regulators-7 (pmic-id "n"): piano omits the second PM8010 die. (R) */
};

&i2c3 {
	status = "okay";

	/*
	 * WCD9395 USBSS SBU/orientation switch for the USB-C connector.
	 * Presence on piano confirmed downstream (sun.dtsi wcd939x_i2c@e,
	 * referenced by &usb0 qcom,wcd_usbss). (R)
	 */
	wcd_usbss: typec-mux@e {
		compatible = "qcom,wcd9395-usbss", "qcom,wcd9390-usbss";
		reg = <0xe>;				/* (R) */

		vdd-supply = <&vreg_l15b_1p8>;		/* (M) */
		reset-gpios = <&tlmm 152 GPIO_ACTIVE_HIGH>;	/* (M), OQ#11 */

		mode-switch;
		orientation-switch;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				wcd_usbss_sbu_mux: endpoint {
					remote-endpoint = <&pmic_glink_sbu>;
				};
			};
			port@1 {
				reg = <1>;

				wcd_usbss_headset_out: endpoint {
					remote-endpoint = <&wcd_codec_headset_in>;
				};
			};
		};
	};
};

/*
 * ADSP (audio + sensors + battery services via pmic-glink) and CDSP.
 * Firmware from the stock NON-HLOS image, staged by the test-image
 * builder as qcom/sm8750/ .mbn headers plus bXX segments. MPSS stays
 * off: piano is a Wi-Fi-only SKU. (R)
 */
&remoteproc_adsp {
	firmware-name = "qcom/sm8750/adsp.mbn",
			"qcom/sm8750/adsp_dtb.mbn";

	status = "okay";
};

&remoteproc_cdsp {
	firmware-name = "qcom/sm8750/cdsp.mbn",
			"qcom/sm8750/cdsp_dtb.mbn";

	status = "okay";
};

&lpass_vamacro {
	vdd-micb-supply = <&vreg_l1b_1p8>;		/* (M) */
	qcom,dmic-sample-rate = <4800000>;		/* (M) */
};

/*
 * WSA884x amps, primary candidate per stock dtbo (OQ#21: exact amp
 * family/address confirmed on first SDW enumeration). Enable pins are
 * shared across buses: tlmm 76 drives amps 0/2, tlmm 77 amps 1/3.
 */
&swr0 {
	status = "okay";

	spkr_fl: speaker@0,1 {
		compatible = "sdw20217020400";
		reg = <0 1>;
		reset-gpios = <&tlmm 76 GPIO_ACTIVE_LOW>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "SpkrFL";
		vdd-1p8-supply = <&vreg_l15b_1p8>;
		vdd-io-supply = <&vreg_l2i_1p2>;
		qcom,port-mapping = <1 2 3 7 10 13>;
	};

	spkr_fr: speaker@0,2 {
		compatible = "sdw20217020400";
		reg = <0 2>;
		reset-gpios = <&tlmm 77 GPIO_ACTIVE_LOW>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "SpkrFR";
		vdd-1p8-supply = <&vreg_l15b_1p8>;
		vdd-io-supply = <&vreg_l2i_1p2>;
		qcom,port-mapping = <4 5 6 7 11 13>;
	};
};

&swr1 {
	status = "okay";

	/* WCD9395 RX */
	wcd_rx: codec@0,4 {
		compatible = "sdw20217010e00";
		reg = <0 4>;
		qcom,rx-port-mapping = <1 2 3 4 5 9>;
	};
};

&swr2 {
	status = "okay";

	/* WCD9395 TX */
	wcd_tx: codec@0,3 {
		compatible = "sdw20217010e00";
		reg = <0 3>;
		qcom,tx-port-mapping = <2 2 3 4>;
	};
};

&swr3 {
	status = "okay";

	spkr_rl: speaker@0,1 {
		compatible = "sdw20217020400";
		reg = <0 1>;
		reset-gpios = <&tlmm 76 GPIO_ACTIVE_LOW>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "SpkrRL";
		vdd-1p8-supply = <&vreg_l15b_1p8>;
		vdd-io-supply = <&vreg_l2i_1p2>;
		qcom,port-mapping = <1 2 3 7 10 13>;
	};

	spkr_rr: speaker@0,2 {
		compatible = "sdw20217020400";
		reg = <0 2>;
		reset-gpios = <&tlmm 77 GPIO_ACTIVE_LOW>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "SpkrRR";
		vdd-1p8-supply = <&vreg_l15b_1p8>;
		vdd-io-supply = <&vreg_l2i_1p2>;
		qcom,port-mapping = <4 5 6 7 11 13>;
	};
};

&mdss {
	status = "okay";
};

&mdss_dsi0 {
	vdda-supply = <&vreg_l3g_1p2>;			/* (M) */

	status = "okay";

	display_panel: panel@0 {
		compatible = "novatek,nt37801";
		reg = <0>;

		/*
		 * Xiaomi Pad 8 Pro panel: NT37801 AMOLED, WQHD+ 1440x3200,
		 * 4 DSI lanes, DSC 2x(720x40) slices, DCS backlight.
		 * Downstream reset GPIO 0x62 = 98. (R)
		 */
		reset-gpios = <&tlmm 98 GPIO_ACTIVE_LOW>;

		vddio-supply = <&vreg_l12b_1p8>;		/* (R): downstream "vddil12b" */
		vci-supply = <&vreg_l13b_3p0>;		/* (M), OQ#16 */
		vdd-supply = <&vreg_l11b_1p0>;		/* (M), OQ#16 */

		pinctrl-0 = <&disp0_reset_n_active>;
		pinctrl-1 = <&disp0_reset_n_suspend>;
		pinctrl-names = "default", "sleep";

		port {
			panel0_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&panel0_in>;
	data-lanes = <0 1 2 3>;
};

&mdss_dsi0_phy {
	vdds-supply = <&vreg_l3i_0p88>;			/* (M) */

	status = "okay";
};

&pmih0108_eusb2_repeater {
	qcom,tune-usb2-preem = /bits/ 8 <0x3>;		/* (M), OQ#12 */
	qcom,tune-usb2-amplitude = /bits/ 8 <0xa>;	/* (M), OQ#12 */
	qcom,squelch-detector-bp = <(-2000)>;		/* (M), OQ#12 */

	vdd18-supply = <&vreg_l15b_1p8>;			/* (M) */
	vdd3-supply = <&vreg_l5b_3p1>;				/* (M) */

	status = "okay";
};

&qup_i2c3_data_clk {
	/* Use internal I2C pull-up */
	bias-pull-up = <2200>;
};

&tlmm {
	gpio-reserved-ranges = <36 4>, <74 1>;		/* (M), OQ#13 */

	/*
	 * WCD9395 codec reset (tlmm 101) and WSA speaker-amper enables
	 * (tlmm 76 = amps 0/2, tlmm 77 = amps 1/3), stock vbdtb
	 * wcd939x_reset_active / spkr_02|13_sd_n_active. (R)
	 */
	wcd_default: wcd-reset-n-active-state {
		pins = "gpio101";
		function = "gpio";
		drive-strength = <16>;
		bias-disable;
		output-low;
	};

	spkr_0_sd_n_active: spkr-0-sd-n-active-state {
		pins = "gpio76";
		function = "gpio";
		drive-strength = <16>;
		bias-disable;
		output-low;
	};

	spkr_1_sd_n_active: spkr-1-sd-n-active-state {
		pins = "gpio77";
		function = "gpio";
		drive-strength = <16>;
		bias-disable;
		output-low;
	};


	disp0_reset_n_active: disp0-reset-n-active-state {
		pins = "gpio98";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	disp0_reset_n_suspend: disp0-reset-n-suspend-state {
		pins = "gpio98";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};
};

&qupv3_1 {
	status = "okay";
};

&spi2 {
	status = "okay";

	/*
	 * NT36532E SPI touch, SE2 of QUPv3 wrap 1. GPIO/frequency
	 * evidence: stock dtbo fragment@53/@55 (local/dtb-downstream/
	 * dtbo-entry0.dts). Downstream also sets "qcom,rt" (GENI
	 * real-time hint) — no upstream binding or driver consumption,
	 * so it is not carried over. (R)
	 */
	pinctrl-0 = <&qup_spi2_data_clk>, <&qup_spi2_cs>;
	pinctrl-1 = <&piano_ts_spi_clk_suspend>,
		    <&piano_ts_spi_mosi_suspend>,
		    <&piano_ts_spi_miso_suspend>;
	pinctrl-names = "default", "sleep";


	touchscreen@0 {
		compatible = "novatek,NVT-ts-spi";			/* (R) */
		reg = <0>;
		status = "okay";

		spi-max-frequency = <19200000>;				/* (R): 0x124f800 */

		novatek,irq-gpios = <&tlmm 162 GPIO_ACTIVE_HIGH>;	/* (R) */
		novatek,lcd-id-gpios = <&tlmm 100 GPIO_ACTIVE_HIGH>;	/* (R), OQ#18 */

		pinctrl-0 = <&qup_spi2_cs>;
		pinctrl-1 = <&piano_ts_cs_suspend>;
		pinctrl-names = "pmx_ts_active", "pmx_ts_suspend";	/* (R) */

		/*
		 * CSOT-family firmware default (dual-panel OQ#15); the BOE
		 * variant must be chosen from the real panel ID before any
		 * device flash use. The blob itself never enters git — it
		 * is consumed by the firmware deb from local/.
		 */
		firmware-name = "novatek/novatek_nt36532_piano_fw_csot.bin";

		/*
		 * Integrated bring-up: the DSI panel is on this branch, so the
		 * touch driver's DRM panel follower binds and probe proceeds
		 * once the panel is prepared. No touch-avdd regulator: the
		 * imported driver does not consume an avdd-supply; downstream
		 * toggles GPIO114 (touch_avdd_vreg) outside the touch node.
		 * (R), OQ#18
		 */
		panel = <&display_panel>;
	};
};

&tlmm {
	gpio-reserved-ranges = <36 4>, <74 1>;		/* (M), OQ#13 */

	/* NT36532E touch: SE2 SPI sleep states, stock dtbo fragment@53. (R) */
	piano_ts_spi_clk_suspend: piano-ts-spi-clk-suspend-state {
		pins = "gpio42";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	piano_ts_spi_mosi_suspend: piano-ts-spi-mosi-suspend-state {
		pins = "gpio41";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		output-low;
	};

	piano_ts_spi_miso_suspend: piano-ts-spi-miso-suspend-state {
		pins = "gpio40";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		output-low;
	};

	piano_ts_cs_suspend: piano-ts-cs-suspend-state {
		pins = "gpio43";
		function = "gpio";
		drive-strength = <6>;
		bias-pull-down;
		output-low;
	};

	/* WCN peach combo: WLAN enable (tlmm 16) and BT sw-ctrl monitor
	 * (tlmm 18), stock dtbo fragments 78/84. (R) */
	wlan_en: wlan-en-state {
		pins = "gpio16";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	bt_default: bt-default-state {
		sw-ctrl-pins {
			pins = "gpio18";
			function = "gpio";
			bias-pull-down;
		};
	};
};

&uart7 {
	status = "okay";
};

/*
 * BT HCI UART: SE14 4-wire (CTS gpio24 / RTS gpio25 / TX gpio26 / RX
 * gpio27), stock vbdtb qupv3_se14_4uart. The hci_qca serdev driver
 * power-sequences the controller through the wcn7850-pmu above and
 * downloads firmware from qca/hmtbtfw*.tlv + qca/hmtnv*. (R)
 */
&uart14 {
	status = "okay";

	pinctrl-0 = <&qup_uart14_default>, <&qup_uart14_cts_rts>;

	bluetooth {
		compatible = "qcom,wcn7850-bt";

		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
		vddaon-supply = <&vreg_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;

		max-speed = <3200000>;
	};
};

/*
 * WLAN: peach on PCIe0 (downstream supported-ids 0x110e; perst gpio102,
 * clkreq gpio103, wake gpio104 — stock vbdtb pcie0 pinctrl). ath12k
 * binds through the experimental peach PCI ID on the bring-up branch.
 * (R), OQ#20
 */
&pcie0 {
	pinctrl-0 = <&pcie0_default_state>;
	pinctrl-names = "default";

	status = "okay";
};

&pcie0_phy {
	vdda-phy-supply = <&vreg_l3i_0p88>;
	vdda-pll-supply = <&vreg_l1d_1p2>;

	status = "okay";
};

&pcieport0 {
	wake-gpios = <&tlmm 104 GPIO_ACTIVE_HIGH>;
	reset-gpios = <&tlmm 102 GPIO_ACTIVE_LOW>;

	wifi@0 {
		compatible = "pci17cb,110e";
		reg = <0x10000 0x0 0x0 0x0 0x0>;

		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
		vddaon-supply = <&vreg_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
		vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
	};
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l1j_0p91>;		/* (M), OQ#14 */
	vdda-pll-supply = <&vreg_l3g_1p2>;		/* (M), OQ#14 */

	status = "okay";
};

&ufs_mem_hc {
	reset-gpios = <&tlmm 215 GPIO_ACTIVE_LOW>;	/* (M), OQ#14 */

	vcc-supply = <&vreg_l17b_2p5>;			/* (M), OQ#14 */
	vcc-max-microamp = <1300000>;
	vccq-supply = <&vreg_l1d_1p2>;			/* (M), OQ#14 */
	vccq-max-microamp = <1200000>;

	status = "okay";
};

&usb {
	status = "okay";
};

&usb_dp_qmpphy {
	vdda-phy-supply = <&vreg_l2d_0p88>;		/* (M), OQ#14 */
	vdda-pll-supply = <&vreg_l3g_1p2>;		/* (M), OQ#14 */

	status = "okay";
};

&usb_dp_qmpphy_out {
	remote-endpoint = <&pmic_glink_ss_in>;
};

&usb_dwc3_hs {
	remote-endpoint = <&pmic_glink_hs_in>;
};

&usb_hsphy {
	vdd-supply = <&vreg_l2d_0p88>;			/* (M), OQ#14 */
	vdda12-supply = <&vreg_l3g_1p2>;		/* (M), OQ#14 */

	phys = <&pmih0108_eusb2_repeater>;

	status = "okay";
};
