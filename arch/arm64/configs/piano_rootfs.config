# GNOME/userdata bring-up profile, merged after piano_defconfig.
# ABL appends stock ramdisks: /pianoinit must not collide with Android /init.
CONFIG_LOCALVERSION="-piano-gnome"
CONFIG_CMDLINE="console=tty0 loglevel=6 consoleblank=0 fbcon=font:TER16x32 rdinit=/pianoinit root=PARTLABEL=userdata rootfstype=ext4 rootwait ro pd_ignore_unused clk_ignore_unused panic=0 module_blacklist=qcom_q6v5_pas"
CONFIG_CMDLINE_FORCE=y
# Keep the bootloader framebuffer. Native display/GPU and ADSP are not ready.
# CONFIG_DRM_MSM is not set
# CONFIG_QCOM_Q6V5_PAS is not set
CONFIG_EXT4_FS=y
# No UFS host probe before the initramfs debug network and SMMU setup.
CONFIG_SCSI_UFSHCD=m
CONFIG_SCSI_UFSHCD_PLATFORM=m
CONFIG_SCSI_UFS_QCOM=m
CONFIG_PHY_QCOM_QMP_UFS=m
# CONFIG_SCSI_UFS_CRYPTO is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=m
CONFIG_UNIX=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_CGROUPS=y
CONFIG_INOTIFY_USER=y
CONFIG_FHANDLE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
